{
  "name": "sistema-costos-presupuestos",
  "version": "1.0.0",
  "description": "Sistema Integral de Gestión de Costos y Presupuestos para Construcción e Ingeniería",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run backend:dev\" \"npm run frontend:dev\"",
    "backend:dev": "cd backend && npm run start:dev",
    "frontend:dev": "cd frontend && npm run dev",
    "backend:build": "cd backend && npm run build",
    "frontend:build": "cd frontend && npm run build",
    "build": "npm run backend:build && npm run frontend:build",
    "backend:migrate": "cd backend && npm run migration:run",
    "backend:migrate:generate": "cd backend && npm run migration:generate",
    "test": "npm run backend:test && npm run frontend:test",
    "backend:test": "cd backend && npm run test",
    "frontend:test": "cd frontend && npm run test",
    "lint": "npm run backend:lint && npm run frontend:lint",
    "backend:lint": "cd backend && npm run lint",
    "frontend:lint": "cd frontend && npm run lint",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "construccion",
    "presupuestos",
    "costos",
    "ingenieria",
    "acu",
    "metrados"
  ],
  "author": "",
  "license": "UNLICENSED"
}
